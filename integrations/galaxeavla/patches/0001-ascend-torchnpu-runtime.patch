+# Added by General-AI-Compiler for Ascend/TorchNPU compatibility.
+
+# SPDX-License-Identifier: LicenseRef-G0.5-Community-1.0
+# Copyright (c) 2026 Galaxea
+
+from unittest import mock
+
+import torch
+
+from g05.utils.common.device import (
+    autocast_context,
+    device_autocast_disabled,
+    device_type,
+    empty_device_cache,
+    synchronize_device,
+)
+
+
+def test_device_type_resolves_nested_batches():
+    batch = {"metadata": ["r1lite"], "input": {"x": torch.ones(2)}}
+    assert device_type(batch) == "cpu"
+    assert device_type("npu:0") == "npu"
+    assert device_type(torch.device("cpu")) == "cpu"
+
+
+def test_cpu_autocast_context_is_usable():
+    x = torch.ones(2, dtype=torch.float32)
+    with autocast_context(x, dtype=torch.bfloat16):
+        result = x @ x
+    assert result.shape == torch.Size([])
+
+
+def test_device_autocast_disabled_uses_tensor_device():
+    @device_autocast_disabled
+    def identity(x):
+        return x + 1
+
+    assert torch.equal(identity(torch.tensor([1.0])), torch.tensor([2.0]))
+
+
+def test_cpu_synchronize_and_empty_cache_are_noops():
+    with mock.patch.object(torch.cuda, "synchronize") as synchronize:
+        synchronize_device("cpu")
+    with mock.patch.object(torch.cuda, "empty_cache") as empty_cache:
+        empty_device_cache(torch.device("cpu"))
+    synchronize.assert_not_called()
+    empty_cache.assert_not_called()
+
+
+def test_registered_npu_backend_is_dispatched(monkeypatch):
+    backend = mock.Mock()
+    backend.is_available.return_value = True
+    monkeypatch.setattr(torch, "npu", backend, raising=False)
+
+    synchronize_device("npu:0")
+    empty_device_cache("npu:0")
+
+    backend.synchronize.assert_called_once_with()
+    backend.empty_cache.assert_called_once_with()
