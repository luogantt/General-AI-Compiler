+
+
+def _gdn_config():
+    return SimpleNamespace(
+        hidden_size=8,
+        linear_num_value_heads=2,
+        linear_num_key_heads=1,
+        linear_key_head_dim=2,
+        linear_value_head_dim=2,
+        linear_conv_kernel_dim=3,
+        hidden_act="silu",
+        rms_norm_eps=1e-6,
+        linear_attn_backend="torch",
+    )
+
+
+def test_gated_delta_net_cpu_ignores_selected_cuda_fast_paths():
+    layer = gated_deltanet_module.Qwen3_5GatedDeltaNet(_gdn_config(), layer_idx=0)
+
+    def forbidden_fast_path(*args, **kwargs):
+        raise AssertionError("a CUDA-only fast path ran for a CPU tensor")
+
+    layer.causal_conv1d_fn = forbidden_fast_path
+    layer.chunk_gated_delta_rule = forbidden_fast_path
+    layer.recurrent_gated_delta_rule = forbidden_fast_path
+
+    result = layer(torch.randn(1, 4, 8))
+
+    assert result.shape == (1, 4, 8)
+    assert torch.isfinite(result).all()
+
+
+def test_vision_attention_cpu_ignores_installed_flash_attention(monkeypatch):
+    config = SimpleNamespace(hidden_size=8, num_heads=2)
+    layer = vision_module.Qwen3_5VisionAttention(config)
+
+    def forbidden_flash_attention(*args, **kwargs):
+        raise AssertionError("FlashAttention ran for a CPU tensor")
+
+    monkeypatch.setattr(vision_module, "_flash_attn_varlen", forbidden_flash_attention)
+    query = torch.randn(4, 2, 4)
+    key = torch.randn(4, 2, 4)
+    value = torch.randn(4, 2, 4)
+    cu_seqlens = torch.tensor([0, 2, 4], dtype=torch.int32)
+
+    result = layer._attend_spatial(query, key, value, cu_seqlens)
+
+    assert result.shape == (4, 8)
+    assert torch.isfinite(result).all()
+
+
+def _original_rank_nine_patchify(images, temporal_patch_size, patch_size, merge_size):
+    total_k, channels, height, width = images.shape
+    grid_h = height // patch_size
+    grid_w = width // patch_size
+    images_temporal = images.unsqueeze(2).expand(
+        -1, -1, temporal_patch_size, -1, -1
+    )
+    return (
+        images_temporal.reshape(
+            total_k,
+            temporal_patch_size,
+            channels,
+            grid_h // merge_size,
+            merge_size,
+            patch_size,
+            grid_w // merge_size,
+            merge_size,
+            patch_size,
+        )
+        .permute(0, 3, 6, 4, 7, 2, 1, 5, 8)
+        .reshape(total_k * grid_h * grid_w, -1)
+    )
+
+
+@torch.no_grad()
+def test_rank_eight_patchify_is_exactly_equal_to_original_rank_nine_expression():
+    for shape, patch_size, merge_size in (
+        ((2, 3, 256, 256), 16, 2),
+        ((3, 2, 16, 24), 4, 2),
+    ):
+        images = torch.arange(torch.tensor(shape).prod()).reshape(shape).float()
+        expected = _original_rank_nine_patchify(images, 2, patch_size, merge_size)
+        actual = _patchify_temporal_images(
+            images,
+            temporal_patch_size=2,
+            patch_size=patch_size,
+            merge_size=merge_size,
+        )
+
+        assert actual.shape == expected.shape
+        assert torch.equal(actual, expected)
