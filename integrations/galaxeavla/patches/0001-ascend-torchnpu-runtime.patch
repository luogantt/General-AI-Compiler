+# Added by General-AI-Compiler for Ascend/TorchNPU compatibility.
+
+# SPDX-License-Identifier: LicenseRef-G0.5-Community-1.0
+# Copyright (c) 2026 Galaxea
+
+"""Small device helpers shared by inference and checkpoint loading.
+
+The upstream inference path historically assumed CUDA for autocast, timing and
+cache cleanup.  These helpers deliberately use PyTorch's registered device
+backend instead, which keeps CUDA behaviour unchanged while also supporting
+PrivateUse1 backends such as TorchNPU.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from contextlib import AbstractContextManager
+from functools import wraps
+from typing import Any
+
+import torch
+
+
+_KNOWN_DEVICE_TYPES = {
+    "cpu",
+    "cuda",
+    "npu",
+    "mps",
+    "xpu",
+    "hpu",
+    "mtia",
+    "meta",
+    "privateuseone",
+}
+_PRIVATEUSE1_BACKEND_NAME = getattr(torch._C, "_get_privateuse1_backend_name", lambda: "")()
+
+
+def device_type(value: Any, *, default: str = "cpu") -> str:
+    """Resolve a PyTorch device type from a device, tensor or nested batch."""
+
+    if isinstance(value, torch.Tensor):
+        return value.device.type
+    if isinstance(value, torch.device):
+        return value.type
+    if isinstance(value, str):
+        candidate = value.split(":", 1)[0].lower()
+        return (
+            candidate
+            if candidate in _KNOWN_DEVICE_TYPES or candidate == _PRIVATEUSE1_BACKEND_NAME
+            else default
+        )
+    if isinstance(value, Mapping):
+        for item in value.values():
+            resolved = device_type(item, default="")
+            if resolved:
+                return resolved
+    elif isinstance(value, Sequence) and not isinstance(value, (str, bytes, bytearray)):
+        for item in value:
+            resolved = device_type(item, default="")
+            if resolved:
+                return resolved
+    return default
+
+
+def current_accelerator_type() -> str | None:
+    """Return the first available registered accelerator backend, if any."""
+
+    # Prefer NPU when both plugins are visible: the Ascend image may ship a CPU
+    # PyTorch wheel whose CUDA namespace exists but is not the execution backend.
+    for backend_name in ("npu", "cuda"):
+        backend = getattr(torch, backend_name, None)
+        is_available = getattr(backend, "is_available", None)
+        if callable(is_available) and is_available():
+            return backend_name
+    return None
+
+
+def autocast_context(
+    value: Any,
+    *,
+    dtype: torch.dtype | None = None,
+    enabled: bool = True,
+) -> AbstractContextManager:
+    """Create autocast for the tensor/device that will execute the operation."""
+
+    kwargs: dict[str, Any] = {"device_type": device_type(value), "enabled": enabled}
+    if dtype is not None:
+        kwargs["dtype"] = dtype
+    return torch.autocast(**kwargs)
+
+
+def device_autocast_disabled(function):
+    """Disable autocast on the device of the first tensor argument."""
+
+    @wraps(function)
+    def wrapped(*args, **kwargs):
+        execution_type = device_type((args, kwargs), default="")
+        if not execution_type:
+            execution_type = current_accelerator_type() or "cpu"
+        with autocast_context(execution_type, enabled=False):
+            return function(*args, **kwargs)
+
+    return wrapped
+
+
+def synchronize_device(value: Any = None) -> None:
+    """Synchronize an available CUDA/NPU backend; CPU is intentionally a no-op."""
+
+    resolved_type = device_type(value, default="") or current_accelerator_type()
+    if not resolved_type or resolved_type == "cpu":
+        return
+    backend = getattr(torch, resolved_type, None)
+    is_available = getattr(backend, "is_available", None)
+    synchronize = getattr(backend, "synchronize", None)
+    if callable(is_available) and is_available() and callable(synchronize):
+        synchronize()
+
+
+def empty_device_cache(value: Any = None) -> None:
+    """Release unused allocator blocks for an available CUDA/NPU backend."""
+
+    resolved_type = device_type(value, default="") or current_accelerator_type()
+    if not resolved_type or resolved_type == "cpu":
+        return
+    backend = getattr(torch, resolved_type, None)
+    is_available = getattr(backend, "is_available", None)
+    empty_cache = getattr(backend, "empty_cache", None)
+    if callable(is_available) and is_available() and callable(empty_cache):
+        empty_cache()
