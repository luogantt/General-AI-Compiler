+def _patchify_temporal_images(
+    images: torch.Tensor,
+    *,
+    temporal_patch_size: int,
+    patch_size: int,
+    merge_size: int,
+) -> torch.Tensor:
+    """Build Conv3D patches without materializing a tensor above rank eight.
+
+    This is algebraically identical to the original rank-nine
+    ``reshape(...).permute(...).reshape(...)`` expression.  The temporal/channel
+    transpose is performed before spatial patch splitting so the largest
+    intermediate has rank eight, which is accepted by TorchNPU.
+    """
+
+    total_k, channels, height, width = images.shape
+    grid_h = height // patch_size
+    grid_w = width // patch_size
+
+    images_temporal = images.unsqueeze(2).expand(
+        -1, -1, temporal_patch_size, -1, -1
+    )
+    # Preserve the original expression's first reinterpretation from
+    # [K, C, T, H, W] to [K, T, C, H, W], then put C,T in their final vector
+    # order and collapse them before splitting both spatial axes.
+    temporal_channels = (
+        images_temporal.reshape(
+            total_k,
+            temporal_patch_size,
+            channels,
+            height,
+            width,
+        )
+        .permute(0, 2, 1, 3, 4)
+        .contiguous()
+        .reshape(total_k, channels * temporal_patch_size, height, width)
+    )
+    return (
+        temporal_channels.reshape(
+            total_k,
+            channels * temporal_patch_size,
+            grid_h // merge_size,
+            merge_size,
+            patch_size,
+            grid_w // merge_size,
+            merge_size,
+            patch_size,
+        )
+        .permute(0, 2, 5, 3, 6, 1, 4, 7)
+        .reshape(total_k * grid_h * grid_w, -1)
+    )
+
