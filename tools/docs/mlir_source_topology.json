    "before": "func.func @demo(%x: i32, %y: i32) -> i32 {\n  %z = arith.constant 0 : i32\n  %a = arith.addi %x, %z : i32\n  %b = arith.addi %a, %y : i32\n  return %b : i32\n}",
    "after": "func.func @demo(%x: i32, %y: i32) -> i32 {\n  %b = arith.addi %x, %y : i32\n  return %b : i32\n}",
